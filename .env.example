# === Laboratorium Maya backend — environment config ===
# Copy this file to .env and fill in real values. NEVER commit .env itself.

# AI provider: "none" (local knowledge-base engine only), "anthropic", or "openai"
AI_PROVIDER=none

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins for production CORS.
# Example: https://nueldev.github.io,https://labmaya.example.com
CORS_ORIGINS=

# Optional — override where the SQLite memory database is stored
MEMORY_DB_PATH=./data/memory.sqlite3
